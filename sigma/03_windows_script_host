title: Windows Script Host Execution
id: 4f4b25f0-ec2c-503d-afc9-34256dcfe6a3
status: test
description: Detects Windows Script Host executables. Tune using command line and parent process.
author: Rohan Sharma
date: 2026-10-20
logsource:
    product: windows
    category: process_creation
detection:
    selection:
        Image|endswith:
            - '\wscript.exe'
            - '\cscript.exe'
    condition: selection
falsepositives:
    - Legitimate administrative activity and approved software behavior
level: medium
tags:
    - attack.execution
    - attack.t1059.005
